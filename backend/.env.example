# Copy to .env and fill in. All variables use the PDFORG_ prefix.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=pdforg
POSTGRES_PASSWORD=pdforg
POSTGRES_DB=pdforg
POSTGRES_PORT=5432
PDFORG_DATABASE_URL=postgresql+psycopg://pdforg:pdforg@localhost:5432/pdforg

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PDFORG_JWT_SECRET=change-me-to-a-long-random-string
PDFORG_ACCESS_TOKEN_TTL_MINUTES=30
PDFORG_REFRESH_TOKEN_TTL_DAYS=30

# ── Backblaze B2 ──────────────────────────────────────────────────────────────
# These are the ONLY place B2 credentials live. They are never sent to clients
# and are never stored in Postgres.
PDFORG_B2_KEY_ID=
PDFORG_B2_APPLICATION_KEY=
PDFORG_B2_BUCKET_ID=
PDFORG_B2_BUCKET_NAME=

# Reject single-shot uploads larger than this (bytes). Default 200 MB.
PDFORG_MAX_UPLOAD_BYTES=209715200

# ── Misc ──────────────────────────────────────────────────────────────────────
# Comma-separated. Leave empty to disable browser CORS entirely (the Qt client
# does not need it).
PDFORG_CORS_ORIGINS=[]
PDFORG_ALLOW_REGISTRATION=true
