# Production environment for docker-compose.prod.yml.
#
# The whole file (minus IMAGE_PREFIX / IMAGE_TAG, which the workflow appends) is stored as
# the `PROD_ENV_FILE` secret on the GitHub `production` environment and written to
# /opt/pdforganizer/.env on every deploy. Edit the secret, not the file on the server.

# Public hostname of the showcase site. The API is served at api.<this>; point both at the VPS.
SITE_DOMAIN=pdforganizer.example.com

# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 48   — signs every access and refresh token. Changing it signs everyone out.
PDFORG_JWT_SECRET=

PDFORG_ACCESS_TOKEN_TTL_MINUTES=30
PDFORG_REFRESH_TOKEN_TTL_DAYS=30

# Backblaze B2 application key scoped to the one bucket. These never leave the server.
PDFORG_B2_KEY_ID=
PDFORG_B2_APPLICATION_KEY=
PDFORG_B2_BUCKET_ID=
PDFORG_B2_BUCKET_NAME=

# Reject single-shot uploads larger than this (bytes). Default 200 MB.
PDFORG_MAX_UPLOAD_BYTES=209715200

# false = only existing accounts can sign in.
PDFORG_ALLOW_REGISTRATION=true
